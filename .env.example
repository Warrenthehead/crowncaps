# Copiez ce fichier en ".env.local" puis remplissez les valeurs.
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-publique

# Adresse publique du site (sans "/" à la fin). En local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://www.mondomaine.com

# Secret du ping quotidien (inventez une longue chaîne aléatoire)
CRON_SECRET=changez-moi-par-une-longue-chaine-aleatoire
